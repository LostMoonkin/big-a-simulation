{
  "name": "big-a-simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @big-a/web --",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run typecheck && npm run build --workspace @big-a/web",
    "preview": "npm run preview --workspace @big-a/web --",
    "check": "npm run build",
    "check:design": "python tools/design-checks/check_model_arithmetic.py",
    "fixtures:p0": "node tools/p0/generate-fixtures.mjs",
    "verify:p0": "node tools/p0/verify.mjs",
    "probe:p0": "node tools/p0/record-numeric.mjs",
    "test": "node tools/sim-runner/verify.mjs",
    "fixtures:p1": "node tools/sim-runner/generate-fixtures.mjs",
    "verify:p1": "node tools/sim-runner/verify.mjs",
    "sim:replay": "node tools/sim-runner/cli.mjs",
    "probe:p1": "node tools/sim-runner/record-golden.mjs",
    "fixtures:p2": "node tools/sim-runner/p2-fixtures.mjs",
    "sim:batch": "node tools/sim-runner/p2-batch.mjs",
    "sim:continue": "node tools/sim-runner/p2-golden.mjs",
    "verify:p2": "node tools/sim-runner/p2-verify.mjs",
    "benchmark": "node tools/sim-runner/p2-benchmark.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
